#: biblioteca/templates/_includes/_footer_principal.html:3
#, python-format
msgid ""
" Actualmente tenemos: %(n_books)s Libros, %(n_autor)s Autores, "
"%(n_editorial)s Editoriales "
msgstr ""
" Currently we have: %(n_books)s Books, %(n_autor)s Authors, "
"%(n_editorial)s Editorials "

